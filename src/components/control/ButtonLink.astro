---
import { Icon } from "astro-icon/components";

interface Props {
	badge?: string;
	url?: string;
	label?: string;
}
const { badge, url, label } = Astro.props;
---
<a href={url} aria-label={label} class="block group/link">
    <button
        class:list={`
            w-full
            h-10
            rounded-xl
            bg-none
            hover:bg-[var(--btn-plain-bg-hover)]
            active:bg-[var(--btn-plain-bg-active)]
            transition-all
            px-2.5
            
            text-neutral-700
            hover:text-[var(--primary)]
            dark:text-neutral-300
            dark:hover:text-[var(--primary)]
        `
        }
    >
        <div class="flex items-center justify-between relative">
            <div class="overflow-hidden text-left whitespace-nowrap overflow-ellipsis text-sm font-medium flex items-center gap-2.5 text-neutral-600 dark:text-neutral-300 group-hover/link:text-[var(--primary)] transition-colors">
                <Icon name="material-symbols:folder-outline-rounded" class="text-lg text-neutral-400 group-hover/link:text-[var(--primary)] transition-colors"></Icon>
                <slot></slot>
            </div>
            { badge !== undefined && badge !== null && badge !== '' &&
                <div class="transition-all px-2.5 py-0.5 ml-4 min-w-[1.75rem] rounded-full text-xs font-semibold
                    text-neutral-400 dark:text-neutral-500
                    bg-black/5 dark:bg-white/10
                    group-hover/link:bg-[var(--primary)]/15 group-hover/link:text-[var(--primary)]
                    flex items-center justify-center">
                    { badge }
                </div>
            }
        </div>
    </button>
</a>
