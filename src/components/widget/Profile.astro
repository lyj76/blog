---
import { Icon } from "astro-icon/components";
import { profileConfig } from "../../config";
import { url } from "../../utils/url-utils";
import ImageWrapper from "../misc/ImageWrapper.astro";

const config = profileConfig;
---
<div class="card-base surface-card p-4 flex flex-col items-center text-center">
    <a aria-label="Go to About Page" href={url('/about/')}
       class="group block relative mx-auto mt-1 lg:mx-0 lg:mt-0 mb-4
       max-w-[12rem] lg:max-w-none overflow-hidden rounded-2xl active:scale-95 shadow-sm transition-all duration-300 hover:shadow-lg">
        <div class="absolute transition pointer-events-none group-hover:bg-black/30 group-active:bg-black/50
        w-full h-full z-50 flex items-center justify-center">
            <Icon name="fa6-regular:address-card"
                  class="transition opacity-0 scale-90 group-hover:scale-100 group-hover:opacity-100 text-white text-5xl">
            </Icon>
        </div>
        <ImageWrapper src={config.avatar || ""} alt="Profile Image of the Author" class="mx-auto lg:w-full h-full lg:mt-0 rounded-2xl object-cover"></ImageWrapper>
    </a>
    <div class="px-2 w-full">
        <div class="font-bold text-xl text-center mb-1 text-neutral-800 dark:text-neutral-100 transition-colors">{config.name}</div>
        <div class="h-1 w-8 bg-gradient-to-r from-[var(--primary)] to-[oklch(0.65_0.18_calc(var(--hue)+40))] mx-auto rounded-full mb-3 opacity-90 transition"></div>
        <div class="text-center text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed mb-4 transition">{config.bio}</div>
        <div class="flex flex-wrap gap-2.5 justify-center mb-1">
            {config.links.length > 1 && config.links.map(item =>
                    <a rel="me" aria-label={item.name} href={item.url} target="_blank" class="btn-regular rounded-xl h-10 w-10 active:scale-90 shadow-sm hover:shadow hover:bg-[var(--primary)]/15 hover:text-[var(--primary)] dark:hover:bg-[var(--primary)]/20 transition-all duration-200">
                        <Icon name={item.icon} class="text-[1.35rem]"></Icon>
                    </a>
            )}
            {config.links.length == 1 && <a rel="me" aria-label={config.links[0].name} href={config.links[0].url} target="_blank"
                                            class="btn-regular rounded-xl h-10 gap-2 px-4 font-semibold active:scale-95 shadow-sm hover:shadow hover:bg-[var(--primary)]/15 hover:text-[var(--primary)] dark:hover:bg-[var(--primary)]/20 transition-all duration-200 text-sm">
                <Icon name={config.links[0].icon} class="text-[1.35rem]"></Icon>
                {config.links[0].name}
            </a>}
        </div>
    </div>
</div>

